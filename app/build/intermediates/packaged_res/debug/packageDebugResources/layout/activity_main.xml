<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_marginTop="55dp"
        android:id="@+id/navigationLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnMorning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="2dp"
            android:text="@string/button_morning"
            android:textSize="12sp"
            android:onClick="btnMorningClick"
            android:backgroundTint="#FFC857"
            android:textColor="#382B20"/>
        <Button
            android:id="@+id/btnDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="2dp"
            android:text="@string/button_day"
            android:textSize="12sp"
            android:onClick="btnDayClick"
            android:backgroundTint="#8ED8F8"
            android:textColor="#17314A"/>
        <Button
            android:id="@+id/btnEvening"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="2dp"
            android:text="@string/button_evening"
            android:textSize="12sp"
            android:onClick="btnEveningClick"
            android:backgroundTint="#C7A4F5"
            android:textColor="#302044"/>
        <Button
            android:id="@+id/btnNight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="2dp"
            android:text="@string/button_night"
            android:textSize="12sp"
            android:onClick="btnNightClick"
            android:backgroundTint="#5279C7"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/navigationLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/layoutMorning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">
            <ImageView
                android:id="@+id/imageMorning"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/cat_morning"
                android:scaleType="fitXY"
                android:contentDescription="@string/morning_scene"/>
            <Button
                android:id="@+id/btnCat"
                android:layout_width="120dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:layout_marginTop="35dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cat_desc"
                android:onClick="onCatClick"
                android:text=""/>
            <Button
                android:id="@+id/btnFood"
                android:layout_width="125dp"
                android:layout_height="90dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="35dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/food_desc"
                android:onClick="onFoodClick"
                android:text=""/>
        </FrameLayout>

        <ImageView
            android:id="@+id/imageDay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/cat_day"
            android:scaleType="fitXY"
            android:visibility="gone"
            android:contentDescription="@string/day_scene"/>
        <ImageView
            android:id="@+id/imageEvening"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/cat_evening"
            android:scaleType="fitXY"
            android:visibility="gone"
            android:contentDescription="@string/evening_scene"/>
        <ImageView
            android:id="@+id/imageNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/cat_night"
            android:scaleType="fitXY"
            android:visibility="gone"
            android:contentDescription="@string/night_scene"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
